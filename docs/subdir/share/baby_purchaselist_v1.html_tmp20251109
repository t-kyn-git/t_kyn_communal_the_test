<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>チェックリスト</title>
    <style>
        /* 見た目を整えるための簡単なスタイル */
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 20px auto;
            padding: 0 15px;
        }
        h3 {
            border-bottom: 2px solid #eee;
            padding-bottom: 10px;
        }
        ul {
            list-style-type: none;
            padding-left: 0;
        }
        li {
            margin-bottom: 10px;
            display: flex;
            align-items: center;
        }
        input[type="checkbox"] {
            margin-right: 10px;
            width: 1.3em;
            height: 1.3em;
            cursor: pointer;
        }
        label {
            cursor: pointer;
        }
    </style>
</head>
<body>

    <h1>購入予定リスト</h1>
    <div id="checklist-container"></div>

    <script>
        // ここにMarkdown形式のテキストをそのまま記載します
        const markdownText = `
### 11月2日時点リスト

- [ ] ベビーカー
- [ ] ハンガー
- [ ] 洗濯用ハンガー
- [ ] 衣装用ケース
- [ ] 洗剤(さらさ)
- [ ] 柔軟剤(ハミング素肌思い)
- [ ] スタイ4,5枚？
- [ ] お洋服4,5枚？
- [ ] 帽子2,3枚
- [ ] 靴下2,3枚
- [ ] ボディーソープ
- [ ] 綿棒
- [ ] 保湿クリーム
- [ ] ガーゼ
- [ ] バス用品収納かご
- [ ] 赤ちゃん用バスタオル3,4枚
- [ ] オムツ
- [ ] オムツ捨て用袋(パン袋)
- [ ] おしり拭き
- [ ] おしり拭き用蓋
- [ ] オムツポーチ
- [ ] 鼻吸い器
- [ ] 爪切り
- [ ] 粉ミルク
- [ ] 哺乳瓶用スポンジ
- [ ] 手形足形とり判子シート
- [ ] 命名紙
- [ ] フォトフレーム
- [ ] 月齢写真用オブジェ&マット
- [ ] 湯上がり用の片手桶
- [ ] ベビーバス掃除用のスポンジ
`;

        /**
         * MarkdownテキストをHTMLに変換して表示する関数
         */
        function renderMarkdown(text) {
            const container = document.getElementById('checklist-container');
            if (!container) return;

            // テキストを行ごとに分割し、空の行は除外する
            const lines = text.split('\n').filter(line => line.trim() !== '');

            let htmlOutput = '';
            let inList = false; // <ul> タグの内側にいるかどうかを管理

            lines.forEach(line => {
                // H3見出しの処理
                if (line.startsWith('### ')) {
                    if (inList) {
                        htmlOutput += '</ul>'; // リストがあれば閉じる
                        inList = false;
                    }
                    htmlOutput += `<h3>${line.substring(4)}</h3>`;
                }
                // 未チェックのリストアイテムの処理
                else if (line.startsWith('- [ ] ')) {
                    if (!inList) {
                        htmlOutput += '<ul>'; // リストを開始する
                        inList = true;
                    }
                    const itemText = line.substring(6);
                    // 各チェックボックスとラベルにユニークなIDを割り当てる
                    const uniqueId = 'item-' + Math.random().toString(36).substr(2, 9);
                    htmlOutput += `<li><input type="checkbox" id="${uniqueId}"><label for="${uniqueId}">${itemText}</label></li>`;
                }
            });

            if (inList) {
                htmlOutput += '</ul>'; // 最後にリストが開いたままなら閉じる
            }

            container.innerHTML = htmlOutput;
        }

        // ページの読み込みが完了したら関数を実行
        document.addEventListener('DOMContentLoaded', () => {
            renderMarkdown(markdownText);
        });
    </script>

</body>
</html>